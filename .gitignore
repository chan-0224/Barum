# 환경변수 — 절대 커밋 금지 (Public 레포)
.env
.env.*
# 템플릿은 커밋해야 한다. 없으면 클론한 사람이 뭘 채울지 모른다
!*.example

# Python
.venv/
__pycache__/
*.pyc

# Node (barum-fe)
node_modules/
.next/
out/

# macOS
.DS_Store

# Public 레포 제외 — 심사위원이 보는 곳이다
# PLAN: 심사 배점 분석·대응 전략  /  TASKS: 내부 진행 상황과 팀원 실명
# 나머지(API·SCREENS·DATA)는 팀원이 봐야 하므로 커밋한다
docs/PLAN.md
docs/TASKS.md

# Java / Gradle
build/
.gradle/

# 배포
.env.production
letsencrypt/

# 테스트용 실물 사진 — Public 레포에 개인 사진을 올리지 않는다
# 루트만 막는다(선행 /). 프론트 에셋은 하위 디렉터리라 영향 없음
/*.jpg
/*.jpeg
/*.png
/*.webp
/*.heic
