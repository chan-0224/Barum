# Supabase Dashboard > Project Settings > Database > Connection string > JDBC
# Transaction Pooler(6543) 사용. prepareThreshold=0 필수 (pgbouncer transaction 모드)
# URL에 &가 들어가므로 반드시 따옴표로 감쌀 것 — 없으면 `. ./.env` 가 parse error로 깨진다
SUPABASE_JDBC_URL="jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?user=postgres.xxxxxxxx&prepareThreshold=0"
SUPABASE_DB_PASSWORD=

# Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co

# 프론트 도메인. 쉼표로 여러 개
CORS_ALLOWED_ORIGINS=http://localhost:3000

# FastAPI AI 서버
AI_BASE_URL=http://localhost:8000
AI_INTERNAL_KEY=
