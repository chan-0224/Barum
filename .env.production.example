# 운영 환경변수. 실제 파일은 .env.production 이며 커밋 금지(.gitignore 처리됨).
# 서버에 직접 만들거나 안전한 경로로 전달할 것. Public 레포라 한 번 올라가면 전부 재발급이다.

# ── 도메인 / 인증서 (운영에서만) ─────────────────────────────
# A 레코드가 서버 공인 IP로 걸려 있어야 Let's Encrypt 발급이 된다
DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Transaction Pooler(6543). prepareThreshold=0 필수 (pgbouncer transaction 모드)
# &가 들어가므로 따옴표로 감쌀 것
SUPABASE_JDBC_URL="jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?user=postgres.xxxxxxxx&prepareThreshold=0"
SUPABASE_DB_PASSWORD=

# RLS를 우회하는 키. Spring·FastAPI는 쓰지 않는다(원칙 4).
# 성분 적재 같은 운영 스크립트에만 필요하므로 서버에는 두지 않아도 된다
# SUPABASE_SERVICE_KEY=

# ── 서비스 간 연결 ──────────────────────────────────────────
# Spring이 FastAPI를 부를 때 쓰는 주소. compose 네트워크 안이라 서비스명으로 붙는다
AI_BASE_URL=http://fastapi:8000
AI_INTERNAL_KEY=

# 프론트 도메인. 쉼표로 여러 개. * 는 호스트·포트 어디에나 쓸 수 있다
#
# 포트 없는 주소는 따로 적어야 한다 — `http://localhost:*` 는 `http://localhost` 를 안 잡는다.
# `http://192.168.*` 는 폰 실기기 테스트용(프론트를 LAN IP로 띄우면 그게 오리진이 된다).
# 목록에 없으면 프리플라이트가 403 `Invalid CORS request` 로 끊긴다.
#
# 운영(가비아) 배포 때는 localhost·192.168 을 빼고 실제 프론트 도메인만 남길 것
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:*,http://127.0.0.1,http://127.0.0.1:*,http://192.168.*,http://192.168.*:*,https://*.vercel.app

# ── 외부 데이터 (FastAPI) ───────────────────────────────────
# data.go.kr Decoding 키
DATA_GO_KR_KEY=

# ── AI (FastAPI, 구교승 담당분) ─────────────────────────────
OPENAI_API_KEY=
